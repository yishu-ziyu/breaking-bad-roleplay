# Production environment variables for Railway deployment
# Set these in Railway's Variables tab — do NOT commit real values.

# LLM API keys (at least one required)
MINIMAX_API_KEY=your-minimax-token-plan-key
STEPFUN_API_KEY=your-stepfun-api-key

# Database (auto-provided by Railway PostgreSQL addon)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# App config
APP_ENV=production
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins (REQUIRED in production)
# Example: ALLOWED_ORIGINS=https://your-app.railway.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
