# Production environment variables for Vercel.
# Set these in Project Settings > Environment Variables — do NOT commit real values.

# LLM API keys (at least one required)
MINIMAX_API_KEY=your-minimax-token-plan-key
STEPFUN_API_KEY=your-stepfun-api-key

# External Postgres database (Supabase pooler is supported)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# App config
APP_ENV=production
LOG_LEVEL=INFO
DIRECTOR_MODEL_ROUTE=minimax/MiniMax-M3
# Keep the request inside Vercel's execution window; dialogue remains persisted.
ENABLE_DOSSIER_UPDATES=false

# CORS — comma-separated list of allowed origins (REQUIRED in production)
ALLOWED_ORIGINS=https://bb.yishuziyu.cn,https://breaking-bad-roleplay.vercel.app

# Frontend build-time Supabase config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
