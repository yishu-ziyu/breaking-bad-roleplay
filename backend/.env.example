# API Keys
MINIMAX_API_KEY=your_minimax_api_key_here
STEPFUN_API_KEY=your_stepfun_api_key_here

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://bb_roleplay:password@localhost:5432/breaking_bad_roleplay

# Environment
APP_ENV=development

# Logging — DEBUG | INFO | WARNING | ERROR (case-insensitive)
LOG_LEVEL=INFO

# CORS — comma-separated origins, or "*" for development
# Empty string = no origins allowed (production default)
ALLOWED_ORIGINS=*
