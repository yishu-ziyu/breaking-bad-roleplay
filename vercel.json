{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.*,**/.env*,backend/.pytest_cache/**,backend/.venv/**,backend/tests/**,deploy/**,dist/**,docs/**,looper-output/**,node_modules/**,playwright-report/**,public/**,scripts/**,src/**,supabase/**,test*/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://bb.yishuziyu.cn/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
